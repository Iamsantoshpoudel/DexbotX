# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public origin of the DASHBOARD (the browser only talks to this origin; Next.js proxies /api/* to this backend).
WEB_URL=http://localhost:3000
# Reverse proxies in front of the API (Cloudflare + load balancer = 2). Needed for correct client IPs in rate limits.
TRUST_PROXY=1

# ───────── Supabase Postgres ─────────
# Long-running servers: use the SESSION pooler (port 5432) or the direct connection string, NOT the transaction pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Defaults to true in production, false otherwise.
DATABASE_SSL=
DATABASE_POOL_MAX=10

# ───────── Redis (sessions, cache, rate limits, pub/sub) ─────────
REDIS_URL=redis://localhost:6379

# ───────── Discord application: https://discord.com/developers/applications ─────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Register this exact URL in the portal → OAuth2 → Redirects:  <WEB_URL>/api/auth/callback
# Invite permissions: 52224 = View Channel + Send Messages + Embed Links + Attach Files (no Administrator needed)
BOT_PERMISSIONS=52224
# "auto" lets Discord pick the shard count
SHARD_COUNT=auto

# ───────── Sessions ─────────
# 32 bytes as 64 hex chars:  openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=604800
# Only needed when the API and dashboard are on different subdomains
COOKIE_DOMAIN=

# ───────── Queue worker ─────────
# Concurrent welcome/goodbye jobs per worker process (scale out by running more worker replicas)
WORKER_CONCURRENCY=5

# ───────── Custom card backgrounds: Supabase Storage (optional; uploads are disabled when unset) ─────────
# Project URL and the SERVICE ROLE key (server-side only; never expose it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# A PRIVATE bucket; the backend creates it on first upload if it does not exist.
SUPABASE_BUCKET=card-backgrounds

# ───────── Observability (optional) ─────────
SENTRY_DSN=
# GET /metrics on the API requires "Authorization: Bearer <token>" (min 16 chars). Unset = endpoint disabled.
METRICS_TOKEN=
# Also serve worker metrics on this port (needs METRICS_TOKEN)
WORKER_METRICS_PORT=
