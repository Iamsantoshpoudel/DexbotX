{
  "name": "dexbotx-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "start:bot": "node dist/bot/manager.js",
    "start:worker": "node dist/worker/worker.js",
    "start:dev": "nest start --watch",
    "start:bot:dev": "nest start --watch --entryFile bot/manager",
    "start:worker:dev": "nest start --watch --entryFile worker/worker",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand --forceExit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:backfill-guild-data": "node dist/db/backfill-guild-data.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@sentry/node": "^11.8.0",
    "bullmq": "^6.3.15",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nestjs-pino": "^4.4.0",
    "on-headers": "^1.1.0",
    "pino": "^9.9.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.0",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "sprintf-js": "^1.1.3"
  }
}
