# Where the Next.js server proxies /api/* to. Set as a Vercel environment variable (applies at build time).
# Local development: backend on your machine. Production: https://dexbotx-zq8g.onrender.com
BACKEND_URL=http://localhost:4000

# Used for canonical links and social metadata. Set this in Vercel for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
