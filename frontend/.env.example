# Where the server-side /api/* proxy connects. Set this on the frontend deployment at runtime.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WS_ORIGIN=ws://localhost:4000

# Public site metadata. Keep these set to the Vercel site origin and the public project links.
NEXT_PUBLIC_SITE_URL=https://dexbotx.vercel.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/Iamsantoshpoudel
NEXT_PUBLIC_DISCORD_SUPPORT_URL=https://discord.gg/RVy67hyCZ

# Optional public profiles used by schema.org sameAs.
NEXT_PUBLIC_YOUTUBE_PROFILE_URL=youtube.com/@dexgamexx1
NEXT_PUBLIC_X_PROFILE_URL=
NEXT_PUBLIC_TWITCH_PROFILE_URL=
NEXT_PUBLIC_INSTAGRAM_PROFILE_URL=
NEXT_PUBLIC_LINKEDIN_PROFILE_URL=

# Optional search-engine verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
